{
  "name": "dsh-quick-prompts",
  "version": "0.1.3",
  "type": "module",
  "description": "DeepSeek Harness 常用指令快捷面板：置顶、搜索、项目指令和安全的草稿插入。",
  "license": "MIT",
  "author": "yxue301603",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "lib/client.js", "cordis.patch.yml", "icon.svg", "README.md", "README.en.md", "docs/VERIFICATION.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:runtime": "node scripts/test-runtime.mjs",
    "check": "npm run build && npm run test && npm run test:browser && npm pack --dry-run"
  },
  "engines": { "node": ">=22.19.0", "dsh": ">=0.2.0-rc.2 <0.3.0" },
  "repository": { "type": "git", "url": "git+https://github.com/yxue301603/dsh-quick-prompts.git" },
  "homepage": "https://github.com/yxue301603/dsh-quick-prompts#readme",
  "bugs": { "url": "https://github.com/yxue301603/dsh-quick-prompts/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "prompts", "shortcuts", "composer"],
  "icon": "icon.svg",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
